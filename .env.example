# Copy these vars into your shell profile (~/.zshrc) or export before running main.py.

# Required for API mode
export GROQ_API_KEY="your grok api key"

# Reliability / reproducibility
export RANDOM_SEED=42
export REQUEST_TIMEOUT_SEC=45
export MAX_RETRIES=3
export RETRY_BACKOFF_SEC=1.5
export RATE_LIMIT_MAX_SLEEP_SEC=420
export STOP_ON_RATE_LIMIT=1
export CALIBRATION_BINS=10
export STRICT_HETEROGENEITY=1
export MIN_UNIQUE_MODELS=4
export PARAPHRASE_MODEL="llama-3.1-8b-instant"
export MAX_TOKENS_AGENT=512
export MAX_TOKENS_PARAPHRASE=512
export STRICT_BENCHMARK=1
export MAX_AGENT_ANSWER_RETRIES=3
export MAX_MISSING_AGENTS_PER_QUESTION=1
export FAIL_ON_MISSING_AGENTS=0

# Quality-focused experiment sizing
export CALIBRATION_SIZE=50
export CONSISTENCY_SIZE=30
export NUM_PARAPHRASES=3
export TEST_SIZE=200
export ALPHA=0.5

# Runtime mode
# 0 = API-only (recommended for laptops)
# 1 = use local Ollama for medium/weak tiers
export USE_LOCAL_OLLAMA=0

# Agent model mapping (API mode)
# Replace with model IDs that are available in your Groq account.
export MODEL_VERY_STRONG="openai/gpt-oss-120b"
export MODEL_STRONG="llama-3.3-70b-versatile"
export MODEL_MEDIUM="qwen/qwen3-32b"
export MODEL_WEAK="openai/gpt-oss-20b"
export MODEL_VERY_WEAK="llama-3.1-8b-instant"
